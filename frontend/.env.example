# Frontend - variables del silo. Copiar a .env.local (no se versiona).

# Backend NestJS del MISMO silo, visto desde el servidor de Next (rewrites de
# /api en desarrollo, rutas /sesion/* y SSR del portal publico). El navegador
# nunca lo usa: siempre llama a /api del mismo origen.
# En Docker Compose: http://api-silo:3001 (alias en la red erp-<slug>_silo)
API_URL="http://localhost:3001"

# Datos del centro que ocupa este silo (el portal publico es del centro,
# no del producto Vinculos). Se leen en runtime en el servidor de Next (R11):
# la misma imagen sirve a todos los silos. El nombre real sale de la API
# (configuracion_centro.nombre_centro); CENTRO_NOMBRE es el respaldo.
CENTRO_NOMBRE="Centro de Prueba"
SITE_URL="http://localhost:3000"

# Estilo visual: moderno (por defecto) o cuaderno.
# TEMA=cuaderno
