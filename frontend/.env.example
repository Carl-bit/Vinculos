# Frontend - variables del silo. Copiar a .env.local (no se versiona).

# Backend NestJS del MISMO silo, visto desde el servidor de Next (rewrites de
# /api en desarrollo, rutas /sesion/* y SSR del portal publico). El navegador
# nunca lo usa: siempre llama a /api del mismo origen.
# En Docker Compose: http://backend:3001
API_URL="http://localhost:3001"

# Datos del centro que ocupa este silo (el portal publico es del centro,
# no del producto Vinculos).
NEXT_PUBLIC_CENTRO_NOMBRE="Centro de Prueba"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
