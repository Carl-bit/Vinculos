# Un archivo .env por silo. Nunca compartir valores entre clientes.

# Identificador del silo: prefija los routers de Traefik y el nombre del stack.
CLIENTE_SLUG=centro-prueba
CENTRO_NOMBRE="Centro de Prueba"
DOMINIO=centro-prueba.ejemplo.cl

# Postgres del silo. POSTGRES_USER es el superusuario: solo existe dentro del
# contenedor db (init). Ningun servicio de la app se conecta con el.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-superusuario
POSTGRES_DB=app
# vinculos_owner: dueño de la BD, solo migraciones (servicio migrate) y seed.
OWNER_DB_PASSWORD=cambiar-owner
# app_user: rol de la API. Distinta de las anteriores.
# Solo caracteres URL-safe en las tres: van dentro de URLs de conexion.
APP_DB_PASSWORD=cambiar-api

# Auth. Distinto por silo, sin excepciones (HS256: 32+ caracteres).
JWT_SECRET=cambiar-por-silo-con-al-menos-32-caracteres
JWT_ACCESO_MINUTOS=15
REFRESH_DIAS=7
# Rate limit por IP (login y portal publico).
LOGIN_LIMITE_POR_MINUTO=10
PUBLICO_LIMITE_POR_MINUTO=60

BLOQUEO_TEMPORAL_TTL_SEGUNDOS=300

# Integraciones (docs/api/integraciones.md). SMTP de la plataforma (vacio =
# correo simulado); el nombre visible del remitente es el del centro.
SMTP_URL=
CORREO_REMITENTE=no-responder@vinculos.cl
# Videollamada: solo nivel 1 (enlace propio de cada profesional) habilitado.
# Jitsi (nivel 2) implementado pero desactivado; URL base del servidor propio.
JITSI_HABILITADO=false
JITSI_URL_BASE=https://meet.jit.si
# Vida del enlace de descarga de un documento clinico enviado por correo (horas).
DOCUMENTO_ENLACE_HORAS=72
# Tamaño maximo de un adjunto externo de la ficha (MB, multipart).
ADJUNTO_MAX_MB=10
