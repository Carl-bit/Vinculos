# Silo de estres (prompts/04_pruebas.md, fase 3). EFIMERO: solo datos demo,
# se borra con `sh infra/stress/bajar.sh`. Valores de prueba, nunca de un silo
# real (CLAUDE.md: nunca compartir valores entre clientes).
CLIENTE_SLUG=stress
CENTRO_NOMBRE="Centro de Estres"
DOMINIO=stress.localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=stress-super
POSTGRES_DB=app
OWNER_DB_PASSWORD=stress-owner
APP_DB_PASSWORD=stress-api

JWT_SECRET=stress-jwt-solo-pruebas-de-carga-0123456789
JWT_ACCESO_MINUTOS=60
SESION_INACTIVIDAD_MINUTOS=120
# k6 sale de una sola IP: los limites por IP se suben para medir capacidad, no el rate limit.
LOGIN_LIMITE_POR_MINUTO=1000
PUBLICO_LIMITE_POR_MINUTO=1000000

BLOQUEO_TEMPORAL_TTL_SEGUNDOS=300
# Correo al Mailpit del silo de estres (k6 lee de alli el codigo del segundo paso).
SMTP_URL=smtp://mailpit:1025
CORREO_REMITENTE=no-responder@vinculos.cl
