# Backend - variables del silo. Copiar a .env (no se versiona).

# Postgres del silo (contraseñas = infra/.env). En Docker Compose el host es db.
# Local: 127.0.0.1, no localhost (en Windows cada conexion nueva del pool tarda
# ~2 s probando ::1 y los jobs fallan con P2028).
# DATABASE_URL: rol de la API (app_user), sujeto a RLS. Lo unico que usa la API.
DATABASE_URL="postgresql://app_user:cambiar-api@127.0.0.1:5432/app?schema=public"
# Solo para migraciones, seed y prisma/scripts/rol_api.js (dueño vinculos_owner).
MIGRATION_DATABASE_URL="postgresql://vinculos_owner:cambiar-owner@127.0.0.1:5432/app?schema=public"
APP_DB_PASSWORD="cambiar-api"

# Puerto del backend Nest.
PORT=3001

# Origen permitido para CORS (frontend del mismo silo).
FRONTEND_URL="http://localhost:3000"

# Auth. JWT_SECRET debe ser distinto por silo, nunca compartido entre clientes
# (HS256: al menos 32 caracteres). Access token corto + refresh token rotativo.
JWT_SECRET="cambiar-por-silo-con-al-menos-32-caracteres"
JWT_ACCESO_MINUTOS=15
SESION_INACTIVIDAD_MINUTOS=30

# Rate limit por IP: login/refresh y portal publico (perfiles, match).
# Desarrollo: 30 (la coleccion Bruno inicia sesion con 11 usuarios seguidos).
# En un silo, el default de la API (10).
LOGIN_LIMITE_POR_MINUTO=30
PUBLICO_LIMITE_POR_MINUTO=60

# Crons de la API (expirar ofertas, procesar bajas, avisos, canarios, envio de
# notificaciones). false en tests: los jobs se llaman a mano.
JOBS_HABILITADOS=true
LOG_LEVEL=info
# Swagger UI en /docs y /docs-json. Sin valor: habilitada salvo NODE_ENV=production.
# DOCS_API=false

# Cifrado (docs/seguridad/cifrado.md). Rutas a archivos, nunca la llave en una
# variable. En desarrollo las crea infra/scripts/reset_dev.sh.
KEK_PATH="../infra/secrets/dev/kek"
RECUPERACION_PUBLICA_PATH="../infra/secrets/dev/recuperacion.pub"

# TTL del soft-lock de agenda, en segundos (solo UX, no reemplaza el EXCLUDE).
BLOQUEO_TEMPORAL_TTL_SEGUNDOS=300
# Vida del enlace de videollamada despues del fin de la cita, en horas.
ENLACE_ONLINE_HORAS_TRAS_FIN=2

# Integraciones (docs/api/integraciones.md). Correo: SMTP generico de la
# plataforma (smtp[s]://usuario:clave@host:puerto); vacio = simulado.
# Desarrollo con Mailpit (docs/pruebas/guion_manual.md): smtp://localhost:1025
# y los correos se ven en http://localhost:8025.
SMTP_URL=""
CORREO_REMITENTE="no-responder@vinculos.cl"
# Videollamada: true = simulada (tests); false = modo de cada profesional.
VIDEOLLAMADA_SIMULADA=false
JITSI_HABILITADO=false
JITSI_URL_BASE="https://meet.jit.si"
# Vida del enlace de descarga de un documento clinico por correo (horas).
DOCUMENTO_ENLACE_HORAS=72
# Tamaño maximo de un adjunto externo de la ficha (MB, multipart).
ADJUNTO_MAX_MB=10
