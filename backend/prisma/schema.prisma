}

// ============================================================================
// 3. Agenda y Espacios
// Fuente de verdad anti-choque: EXCLUDE USING gist sobre
// tstzrange(inicio, fin) por espacio y por profesional (migracion cruda).
// ============================================================================

/// POR_REPROGRAMAR: el tratante se fue o cambio y la cita no se pudo
/// mantener; no ocupa box ni horario (fuera del EXCLUDE).
enum EstadoCita {
  CONFIRMADA
  CANCELADA
  POR_REPROGRAMAR
  /// 03a (C-15), retirado en 03b-3.2 (CHECK citas_sin_solicitada): el pago validado es la aprobacion.
  SOLICITADA
  /// 03b-3.1: correo verificado, esperando el pago (bloquea la hora hasta pago_vence_en).
  PENDIENTE_PAGO
  /// 03b-3.1: vencio el plazo de pago (job); la hora queda libre.
  LIBERADA
  /// 03b-3.2: hora retenida de quien pide sin cuenta: SIN paciente hasta el pago
  /// validado (o el correo verificado si paga en el centro). Bloquea la hora (EXCLUDE).
  RETENIDA

  @@map("estado_cita")
}

/// Modalidad de una cita o de un bloque de disponibilidad.
enum ModalidadAtencion {
  PRESENCIAL
  ONLINE

  @@map("modalidad_atencion")
}

enum MotivoBloqueoAgenda {
  VACACIONES
  LICENCIA
  PERSONAL
  BAJA

  @@map("motivo_bloqueo_agenda")
}

model Espacio {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String   @unique
  activo             Boolean  @default(true)
  /// 03a: descripcion corta y duracion de sesion sugerida (presentacion).
  nota               String?
  duracionDefectoMin Int?     @map("duracion_defecto_min") @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  citas              Cita[]
  bloqueosTemporales BloqueoTemporal[]
  arriendos          Arriendo[]
  horarios           HorarioEspacio[]
  solicitudesHora    SolicitudHora[]
  bloquesAtencion    BloqueAtencion[]

  @@map("espacios")
}

/// Rango [inicio, fin). Se usan dos columnas timestamptz en vez de tstzrange
/// porque Prisma no soporta tipos range; el EXCLUDE arma el rango con
/// tstzrange(inicio, fin, '[)'), asi una cita que termina 10:00 no choca con
/// otra que empieza 10:00. espacio_id solo si es PRESENCIAL (CHECK); el
/// EXCLUDE por box aplica solo a presenciales, el por profesional a ambas.
/// Trigger: dentro de la disponibilidad de su modalidad y fuera de bloqueos.
model Cita {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  espacioId         String?            @map("espacio_id") @db.Uuid
  modalidad         ModalidadAtencion  @default(PRESENCIAL)
  /// Fijado al confirmar (margen vigente del profesional). EXCLUDE
  /// citas_margen_traslado: distinta modalidad necesita ese margen.
  margenTrasladoMin Int                @default(0) @map("margen_traslado_min") @db.SmallInt
  /// cifrado (CLINICO). Solo ONLINE (CHECK). Lo genera la API (02) con la cita ya creada.
  enlaceOnline      Bytes?             @map("enlace_online")
  profesionalId     String             @map("profesional_id") @db.Uuid
  /// Nulo solo en RETENIDA (o LIBERADA sin concretar): CHECK citas_paciente_segun_estado.
  pacienteId        String?            @map("paciente_id") @db.Uuid
  inicio            DateTime           @db.Timestamptz(6)
  fin               DateTime           @db.Timestamptz(6)
  estado            EstadoCita         @default(CONFIRMADA)
  /// 02h, CLP. Lo fija la BD al confirmar con la tarifa mas especifica vigente
  /// (trigger citas_monto_fijado). Inmutable. Nulo = cita anterior a Cobros.
  monto             Int?
  /// Lo fija la BD al pasar a CANCELADA (plazo de aviso de la politica de cancelacion).
  canceladaEn       DateTime?          @map("cancelada_en") @db.Timestamptz(6)
  /// 02i: SEQUENCE del evento de calendario (UID fijo por cita). La sube la BD
  /// en cada cambio de horario, modalidad, box o estado.
  secuencia         Int                @default(0)
  /// 03b-3.1: medio elegido para confirmar y plazo de pago (CHECK: PENDIENTE_PAGO
  /// lo exige). Solo los fija el flujo de confirmacion (trigger citas_estado_pago_protegido).
  medioConfirmacion MedioConfirmacion? @map("medio_confirmacion")
  pagoVenceEn       DateTime?          @map("pago_vence_en") @db.Timestamptz(6)
  /// 03b-3.2: la agendo el equipo (plazo de pago hasta 12 h antes, avisos 48 h / 24 h).
  /// Lo fija la BD (trigger citas_pago_previo_equipo).
  agendadaPorEquipo Boolean            @default(false) @map("agendada_por_equipo")
  /// 03b-3.2: ultimo recordatorio de pago enviado (48 o 24 h antes). Lo fija el job.
  ultimoAvisoPago   Int?               @map("ultimo_aviso_pago") @db.SmallInt
  /// 03b-3.3: aviso de deuda enviado (sesion terminada con saldo). Lo fija el job.
  avisoDeudaEn      DateTime?          @map("aviso_deuda_en") @db.Timestamptz(6)
  /// 03b-3.3: hora retenida liberada a mano (ADMIN/GESTION, con motivo; liberar_hora_retenida).
  liberadaPorId     String?            @map("liberada_por_id") @db.Uuid
  motivoLiberacion  String?            @map("motivo_liberacion")
  /// 03b-3.4: medio elegido para pagar en linea el saldo de la sesion ya realizada.
  medioSaldo        MedioConfirmacion? @map("medio_saldo")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transferencias        Transferencia[]
  cobrosPasarela        CobroPasarela[]
  espacio               Espacio?            @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  profesional           Usuario             @relation("CitaProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  liberadaPor           Usuario?            @relation("CitaLiberadaPor", fields: [liberadaPorId], references: [id], onDelete: Restrict)
  paciente              Paciente?           @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  pagos                 Pago[]
  excepcionMorosidad    ExcepcionMorosidad?
  boleta                Boleta?
  resolucion            ResolucionCita?     @relation("ResolucionCita")
  resolucionesComoNueva ResolucionCita[]    @relation("ResolucionCitaNueva")
  recordatorios         RecordatorioCita[]
  evoluciones           Evolucion[]
  borradores            BorradorEvolucion[]
  solicitud             SolicitudHora?

  @@index([pacienteId])
  @@map("citas")
}

/// Soft-lock de UX con TTL. No participa del EXCLUDE ni lo reemplaza.
/// inicio/fin: el slot que el admin tiene abierto en pantalla. Retiene siempre
/// al profesional y el box solo si es presencial.
model BloqueoTemporal {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  espacioId     String?           @map("espacio_id") @db.Uuid
  /// Nulo solo en la retencion de una solicitud de hora sin cuenta (03a).
  usuarioId     String?           @map("usuario_id") @db.Uuid
  solicitudId   String?           @unique @map("solicitud_id") @db.Uuid
  profesionalId String            @map("profesional_id") @db.Uuid
  modalidad     ModalidadAtencion @default(PRESENCIAL)
  inicio        DateTime          @db.Timestamptz(6)
  fin           DateTime          @db.Timestamptz(6)
  expiraEn      DateTime          @map("expira_en") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  espacio     Espacio?       @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  usuario     Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  profesional Usuario        @relation("BloqueoTemporalProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  solicitud   SolicitudHora? @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([espacioId, expiraEn])
  @@map("bloqueos_temporales")
}

/// Disponibilidad semanal en minutos desde la medianoche de Chile (0-1440;
/// 1440 = fin del dia). Se convierte con minuto_local(). Edita el propio y
/// ADMIN/GESTION. Otros: disponibilidad_publica().
model DisponibilidadProfesional {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId String            @map("profesional_id") @db.Uuid
  /// ISO: 1 = lunes ... 7 = domingo
  diaSemana     Int               @map("dia_semana") @db.SmallInt
  inicioMin     Int               @map("inicio_min") @db.SmallInt
  finMin        Int               @map("fin_min") @db.SmallInt
  modalidad     ModalidadAtencion
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  profesional Usuario @relation(fields: [profesionalId], references: [id], onDelete: Restrict)

  @@index([profesionalId])
  @@map("disponibilidad_profesional")
}

/// Bloqueo de agenda (fin nulo = indefinido). El motivo no se expone a otros.
/// BAJA solo lo crea iniciar_baja_profesional.
model BloqueoAgenda {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId String              @map("profesional_id") @db.Uuid
  inicio        DateTime            @db.Timestamptz(6)
  fin           DateTime?           @db.Timestamptz(6)
  motivo        MotivoBloqueoAgenda
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  profesional Usuario @relation(fields: [profesionalId], references: [id], onDelete: Restrict)

  @@index([profesionalId, inicio])
  @@map("bloqueos_agenda")
}

// ============================================================================
// 4. Equipo (RR.HH. y Perfiles). Extiende usuarios 1:1 (PK = usuario_id).
// ============================================================================

enum Modalidad {
  PRESENCIAL
  ONLINE
  MIXTA

  @@map("modalidad")
}

/// Catalogo (categoria B): todo autenticado lee, solo ADMIN escribe. Nunca se
/// borra: se desactiva.
model TipoAtencion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profesionales ProfesionalTipoAtencion[]
  derivaciones  Derivacion[]
  pacientes     Paciente[]
  tarifas       Tarifa[]

  @@map("tipos_atencion")
}

/// Tipos de atencion que ofrece cada profesional (N:M, categoria B). Mismo
/// patron que tipos_sesion (02h): el profesional propone (PROPUESTO), ADMIN
/// aprueba o rechaza. Solo los APROBADOS cuentan en el match, los perfiles
/// publicos y el directorio (candidatos de derivacion).
model ProfesionalTipoAtencion {
  profesionalId  String           @map("profesional_id") @db.Uuid
  tipoAtencionId String           @map("tipo_atencion_id") @db.Uuid
  estado         EstadoTipoSesion @default(PROPUESTO)
  revisadoPorId  String?          @map("revisado_por_id") @db.Uuid
  revisadoEn     DateTime?        @map("revisado_en") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  profesional  Usuario      @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  tipoAtencion TipoAtencion @relation(fields: [tipoAtencionId], references: [id], onDelete: Restrict)
  revisadoPor  Usuario?     @relation("TipoAtencionRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: Restrict)

  @@id([profesionalId, tipoAtencionId])
  @@index([tipoAtencionId])
  @@map("profesional_tipos_atencion")
}

/// Perfil autogestionado (categoria A+C): la fila completa la leen
/// ADMIN/GESTION y el propio; lo publico sale por perfiles_publicos(), solo con
/// perfil_publico = true. Encender perfil_publico solo lo hace el propio y
/// exige tarifa general vigente (trigger fija la fecha de consentimiento).
model Profesional {
  usuarioId                 String    @id @map("usuario_id") @db.Uuid
  especialidad              String
  enfoques                  String[]  @default([])
  modalidad                 Modalidad
  /// Solo cuenta con configuracion_centro.modelo_cobro = MIXTO.
  cobroDirecto              Boolean   @default(false) @map("cobro_directo")
  /// Nulo = usa configuracion_centro.margen_traslado_min.
  margenTrasladoMin         Int?      @map("margen_traslado_min")
  nombrePublico             String?   @map("nombre_publico")
  bio                       String?
  fotoUrl                   String?   @map("foto_url")
  perfilPublico             Boolean   @default(false) @map("perfil_publico")
  perfilPublicoConsentidoEn DateTime? @map("perfil_publico_consentido_en") @db.Timestamptz(6)
  /// 03a (D-7): emite boleta reembolsable (isapre o seguro complementario).
  boletaReembolsable        Boolean   @default(false) @map("boleta_reembolsable")
  /// 03a (D-7): convenios con los que atiende (FONASA, isapres).
  convenios                 String[]  @default([])
  idiomas                   String[]  @default([])
  citaDestacada             String?   @map("cita_destacada")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("profesionales")
}

enum TipoTrayectoria {
  TITULO
  POSTITULO
  DIPLOMADO
  MAGISTER
  DOCTORADO
  OTRO

  @@map("tipo_trayectoria")
}

/// Trayectoria (A). Edita el propio (cualquier cambio quita la verificacion);
/// solo ADMIN verifica. Publico: solo titulos verificados.
model ProfesionalTrayectoria {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId            String          @map("profesional_id") @db.Uuid
  tipo                     TipoTrayectoria
  titulo                   String
  institucion              String
  anio                     Int
  registroSuperintendencia String?         @map("registro_superintendencia")
  documentoRespaldoUrl     String?         @map("documento_respaldo_url")
  verificado               Boolean         @default(false)
  verificadoPorId          String?         @map("verificado_por_id") @db.Uuid
  verificadoEn             DateTime?       @map("verificado_en") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profesional   Usuario  @relation("TrayectoriaProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  verificadoPor Usuario? @relation("TrayectoriaVerificadaPor", fields: [verificadoPorId], references: [id], onDelete: Restrict)

  @@index([profesionalId])
  @@map("profesional_trayectoria")
}

/// Datos privados (A, todo cifrado FINANCIERO salvo rut IDENTIFICACION).
/// Edita el propio; leen el propio y ADMIN/GESTION. El PACIENTE solo via
/// datos_pago_profesional() con cobro directo.
model ProfesionalDatosPrivados {
  usuarioId    String   @id @map("usuario_id") @db.Uuid
  rut          Bytes?
  rutHmac      Bytes?   @unique @map("rut_hmac")
  banco        Bytes?
  tipoCuenta   Bytes?   @map("tipo_cuenta")
  numeroCuenta Bytes?   @map("numero_cuenta")
  titular      Bytes?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("profesional_datos_privados")
}

/// Tarifas (A) en CLP, fijadas por el propio. Historial: una fila nueva
/// reemplaza a la anterior desde vigente_desde; sin UPDATE ni DELETE. Tipo y
/// modalidad nulos = tarifa general (obligatoria para publicar el perfil).
model Tarifa {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId  String             @map("profesional_id") @db.Uuid
  tipoAtencionId String?            @map("tipo_atencion_id") @db.Uuid
  modalidad      ModalidadAtencion?
  monto          Int
  vigenteDesde   DateTime           @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  profesional  Usuario       @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  tipoAtencion TipoAtencion? @relation(fields: [tipoAtencionId], references: [id], onDelete: Restrict)

  @@index([profesionalId, vigenteDesde])
  @@map("tarifas")
}

model Practicante {
  usuarioId            String   @id @map("usuario_id") @db.Uuid
  fechaInicio          DateTime @map("fecha_inicio") @db.Date
  fechaTerminoPractica DateTime @map("fecha_termino_practica") @db.Date
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("practicantes")
}

/// Supervision de un practicante por un PROFESIONAL activo. [desde, hasta),
/// hasta nulo = abierta. EXCLUDE (migracion cruda): una vigente por
/// practicante. Sin supervision vigente el practicante no tiene acceso.
model Supervision {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  practicanteId String    @map("practicante_id") @db.Uuid
  supervisorId  String    @map("supervisor_id") @db.Uuid
  desde         DateTime  @default(now()) @db.Timestamptz(6)
  hasta         DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  practicante Usuario @relation("SupervisionPracticante", fields: [practicanteId], references: [id], onDelete: Restrict)
  supervisor  Usuario @relation("SupervisionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([practicanteId])
  @@index([supervisorId])
  @@map("supervisiones")
}

// ============================================================================
// 5. Cobros. Montos en CLP (enteros).
// ============================================================================

enum ModeloCobro {
  CENTRO
  DIRECTO
  MIXTO

  @@map("modelo_cobro")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  /// 03a (D-7): bono FONASA o convenio.
  CONVENIO
  /// 03b-3.1: pago en linea confirmado por el webhook de la pasarela.
  PASARELA

  @@map("medio_pago")
}

enum EstadoPago {
  REGISTRADO
  ANULADO

  @@map("estado_pago")
}

/// MANUAL: lo registra el equipo. TRASLADO: viene de un pago anulado de otra
/// cita (cancelacion con traslado a una cita nueva). PASARELA (03b-3.1): lo
/// registra el webhook, sin usuario.
enum OrigenPago {
  MANUAL
  TRASLADO
  PASARELA

  @@map("origen_pago")
}

/// Quien recibe el dinero: se fija al registrar segun cobro_directo().
enum CobradoPor {
  CENTRO
  PROFESIONAL

  @@map("cobrado_por")
}

/// TRASLADO: los pagos pasan a cita_nueva (credito de una cancelacion a
/// tiempo, o reprogramacion de una tardia). DEVOLUCION: se devuelve lo pagado
/// menos lo exigible. INASISTENCIA: cita confirmada sin aviso del paciente.
enum DecisionCita {
  TRASLADO
  DEVOLUCION
  INASISTENCIA

  @@map("decision_cita")
}

enum EstadoLiquidacion {
  BORRADOR
  EMITIDA
  PAGADA

  @@map("estado_liquidacion")
}

/// Cobro de box al profesional por periodo [periodo_desde, periodo_hasta).
/// Escriben ADMIN/GESTION; el profesional ve los suyos.
model Arriendo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId String   @map("profesional_id") @db.Uuid
  espacioId     String?  @map("espacio_id") @db.Uuid
  periodoDesde  DateTime @map("periodo_desde") @db.Date
  periodoHasta  DateTime @map("periodo_hasta") @db.Date
  monto         Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profesional Usuario  @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  espacio     Espacio? @relation(fields: [espacioId], references: [id], onDelete: Restrict)

  @@index([profesionalId])
  @@map("arriendos")
}

/// Pago de una cita (A). Solo via registrar_pago() (sobrepago = 23514) y
/// anular_pago() (con motivo); nunca DELETE. Saldo: vista estado_pago_citas.
model Pago {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citaId          String     @map("cita_id") @db.Uuid
  monto           Int
  medioPago       MedioPago  @map("medio_pago")
  fecha           DateTime   @default(now()) @db.Timestamptz(6)
  estado          EstadoPago @default(REGISTRADO)
  origen          OrigenPago @default(MANUAL)
  cobradoPor      CobradoPor @default(CENTRO) @map("cobrado_por")
  trasladoDeId    String?    @unique @map("traslado_de_id") @db.Uuid
  registradoPorId String?    @map("registrado_por_id") @db.Uuid
  anuladoEn       DateTime?  @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId    String?    @map("anulado_por_id") @db.Uuid
  motivoAnulacion String?    @map("motivo_anulacion")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  cita          Cita           @relation(fields: [citaId], references: [id], onDelete: Restrict)
  trasladoDe    Pago?          @relation("PagoTraslado", fields: [trasladoDeId], references: [id], onDelete: Restrict)
  trasladadoA   Pago?          @relation("PagoTraslado")
  registradoPor Usuario?       @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  anuladoPor    Usuario?       @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  transferencia Transferencia?
  cobroPasarela CobroPasarela?

  @@index([citaId])
  @@map("pagos")
}

enum EstadoTransferencia {
  POR_VALIDAR
  VALIDADA
  RECHAZADA

  @@map("estado_transferencia")
}

/// 03b-3.1 (A): transferencia de una cita PENDIENTE_PAGO. Comprobante opcional
/// (PDF, PNG o JPEG validado por contenido; cifrado, id generado por la API).
/// 03b-3.3 (A): autorizacion de ADMIN/GESTION para agendar a un paciente con
/// deuda (motivo, saldo del momento). Solo via autorizar_cita_con_deuda; el
/// trigger citas_paciente_moroso la usa una vez (cita_id) en la misma
/// transaccion. Append-only incluso dueño.
model ExcepcionMorosidad {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId    String   @map("paciente_id") @db.Uuid
  citaId        String?  @unique @map("cita_id") @db.Uuid
  saldo         Int
  motivo        String
  otorgadaPorId String   @map("otorgada_por_id") @db.Uuid
  otorgadaEn    DateTime @default(now()) @map("otorgada_en") @db.Timestamptz(6)
  transaccion   BigInt   @default(dbgenerated("txid_current()"))

  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  cita        Cita?    @relation(fields: [citaId], references: [id], onDelete: Restrict)
  otorgadaPor Usuario  @relation(fields: [otorgadaPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@map("excepciones_morosidad")
}

/// Valida GESTION/ADMIN (cobro del centro) o el profesional (cobro directo):
/// registra el pago (pago_id) y confirma. Sin GRANT de escritura: solo funciones.
model Transferencia {
  id                  String              @id @db.Uuid
  /// 03b-3.4: a lo mas una abierta (no VALIDADA) por cita (indice unico parcial
  /// transferencias_una_abierta); la validada queda como historial.
  citaId              String              @map("cita_id") @db.Uuid
  estado              EstadoTransferencia @default(POR_VALIDAR)
  /// 03b-3.4: transferencia del saldo de una sesion ya realizada (deuda).
  deSaldo             Boolean             @default(false) @map("de_saldo")
  /// cifrado (FINANCIERO)
  comprobante         Bytes?
  comprobanteTipo     String?             @map("comprobante_tipo")
  comprobanteNombre   String?             @map("comprobante_nombre")
  comprobanteSubidoEn DateTime?           @map("comprobante_subido_en") @db.Timestamptz(6)
  motivoRechazo       String?             @map("motivo_rechazo")
  resueltaPorId       String?             @map("resuelta_por_id") @db.Uuid
  resueltaEn          DateTime?           @map("resuelta_en") @db.Timestamptz(6)
  pagoId              String?             @unique @map("pago_id") @db.Uuid
  creadaEn            DateTime            @default(now()) @map("creada_en") @db.Timestamptz(6)

  cita        Cita     @relation(fields: [citaId], references: [id], onDelete: Restrict)
  resueltaPor Usuario? @relation(fields: [resueltaPorId], references: [id], onDelete: Restrict)
  pago        Pago?    @relation(fields: [pagoId], references: [id], onDelete: Restrict)

  @@index([citaId])
  @@index([estado])
  @@map("transferencias")
}

enum EstadoCobroPasarela {
  PENDIENTE
  PAGADO
  FALLIDO

  @@map("estado_cobro_pasarela")
}

/// 03b-3.1 (A): intento de cobro en linea. El id es la referencia que viaja a
/// la pasarela; evento_id hace idempotente el webhook. Lee ADMIN/GESTION.
model CobroPasarela {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citaId      String              @map("cita_id") @db.Uuid
  monto       Int
  estado      EstadoCobroPasarela @default(PENDIENTE)
  eventoId    String?             @unique @map("evento_id")
  pagoId      String?             @unique @map("pago_id") @db.Uuid
  creadoEn    DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  procesadoEn DateTime?           @map("procesado_en") @db.Timestamptz(6)

  cita Cita  @relation(fields: [citaId], references: [id], onDelete: Restrict)
  pago Pago? @relation(fields: [pagoId], references: [id], onDelete: Restrict)

  @@index([citaId])
  @@map("cobros_pasarela")
}

/// Una boleta por cita, emitida al quedar PAGADA (emitir_boleta). Copia del
/// emisor (cifrada): documento tributario de retencion, sobrevive al cierre
/// de cuenta. pdf_url nulo = aun no generada (SII simulado).
model Boleta {
  id           String   @id @db.Uuid
  citaId       String   @unique @map("cita_id") @db.Uuid
  numero       String   @unique
  monto        Int
  pdfUrl       String?  @map("pdf_url")
  /// cifrado (IDENTIFICACION)
  emisorNombre Bytes    @map("emisor_nombre")
  /// cifrado (IDENTIFICACION)
  emisorRut    Bytes    @map("emisor_rut")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Restrict)

  @@map("boletas")
}

/// Decision de cobro sobre una cita cancelada o con inasistencia (A,
/// append-only, una por cita). Solo via resolver_cita(), que copia el
/// porcentaje vigente de configuracion_centro.
model ResolucionCita {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citaId                  String       @unique @map("cita_id") @db.Uuid
  decision                DecisionCita
  /// Cancelacion con aviso dentro del plazo (nulo en INASISTENCIA).
  aTiempo                 Boolean?     @map("a_tiempo")
  porcentaje              Decimal      @db.Decimal(5, 2)
  montoExigible           Int          @map("monto_exigible")
  montoDevolucion         Int          @map("monto_devolucion")
  citaNuevaId             String?      @map("cita_nueva_id") @db.Uuid
  motivo                  String?
  decididoPorId           String       @map("decidido_por_id") @db.Uuid
  decididoEn              DateTime     @default(now()) @map("decidido_en") @db.Timestamptz(6)
  /// 03b-3.3: TRASLADO o DEVOLUCION de una cita confirmada ya terminada
  /// (inasistencia justificada, con motivo; se trata como cancelacion tardia).
  inasistenciaJustificada Boolean      @default(false) @map("inasistencia_justificada")

  cita        Cita    @relation("ResolucionCita", fields: [citaId], references: [id], onDelete: Restrict)
  citaNueva   Cita?   @relation("ResolucionCitaNueva", fields: [citaNuevaId], references: [id], onDelete: Restrict)
  decididoPor Usuario @relation(fields: [decididoPorId], references: [id], onDelete: Restrict)

  @@map("resoluciones_cita")
}

/// Liquidacion por profesional y periodo (A): pagos cobrados por el centro -
/// comision - arriendos. BORRADOR -> EMITIDA -> PAGADA solo via funciones
/// (ADMIN/GESTION). EXCLUDE: sin periodos solapados por profesional.
model Liquidacion {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId      String            @map("profesional_id") @db.Uuid
  periodoDesde       DateTime          @map("periodo_desde") @db.Date
  periodoHasta       DateTime          @map("periodo_hasta") @db.Date
  totalCobrado       Int               @map("total_cobrado")
  comisionPorcentaje Decimal           @map("comision_porcentaje") @db.Decimal(5, 2)
  comision           Int
  arriendos          Int
  total              Int
  estado             EstadoLiquidacion @default(BORRADOR)
  creadaPorId        String            @map("creada_por_id") @db.Uuid
  creadaEn           DateTime          @default(now()) @map("creada_en") @db.Timestamptz(6)
  emitidaEn          DateTime?         @map("emitida_en") @db.Timestamptz(6)
  pagadaEn           DateTime?         @map("pagada_en") @db.Timestamptz(6)

  profesional Usuario @relation("LiquidacionProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  creadaPor   Usuario @relation("LiquidacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: Restrict)

  @@index([profesionalId])
  @@map("liquidaciones")
}

// ============================================================================
// 6. Documentos clinicos por correo (02h, Fichas y Pacientes)
// ============================================================================

/// Catalogo (B) por centro: epicrisis, receta, justificativo... Solo ADMIN
/// escribe; nunca DELETE (se desactiva).
model TipoDocumentoClinico {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @unique
  activo    Boolean  @default(true)
  /// 02i: plantilla del documento. Variables permitidas: nombre_paciente,
  /// nombre_profesional, fecha, nombre_centro y contenido (lo que redacta el
  /// profesional). CHECK tipos_documento_clinico_plantilla_valida.
  plantilla String   @default("{{contenido}}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  documentos DocumentoClinico[]

  @@map("tipos_documento_clinico")
}

enum ModoEnvioDocumento {
  ENLACE
  ADJUNTO

  @@map("modo_envio_documento")
}

/// Documento emitido por el tratante para su paciente (A). Contenido cifrado
/// (CLINICO); id generado por la API (AAD). Append-only. Unico contenido
/// clinico que sale por correo (ver docs/api/integraciones.md).
model DocumentoClinico {
  id                  String    @id @db.Uuid
  pacienteId          String    @map("paciente_id") @db.Uuid
  tipoDocumentoId     String    @map("tipo_documento_id") @db.Uuid
  emitidoPorId        String    @map("emitido_por_id") @db.Uuid
  nombreArchivo       String    @map("nombre_archivo")
  tipoMime            String    @map("tipo_mime")
  /// cifrado (CLINICO): texto del documento (plantilla del tipo con las
  /// variables y lo redactado). El PDF se genera al entregarlo (02i).
  contenido           Bytes
  /// El paciente pidio explicitamente recibirlo adjunto (solicitar_adjunto_documento).
  adjuntoSolicitadoEn DateTime? @map("adjunto_solicitado_en") @db.Timestamptz(6)
  emitidoEn           DateTime  @default(now()) @map("emitido_en") @db.Timestamptz(6)

  paciente      Paciente             @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  tipoDocumento TipoDocumentoClinico @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  emitidoPor    Usuario              @relation(fields: [emitidoPorId], references: [id], onDelete: Restrict)
  envios        EnvioDocumento[]
  descargas     DescargaDocumento[]

  @@index([pacienteId])
  @@map("documentos_clinicos")
}

/// Envio de un documento por correo (A, append-only: auditoria del envio).
/// ENLACE (por defecto): token de un solo valor, guardado como SHA-256
/// (token_hash) y cifrado para el job de correo (enlace, CLINICO); expira y
/// exige iniciar sesion. ADJUNTO: solo si el paciente lo pidio.
model EnvioDocumento {
  id           String             @id @db.Uuid
  documentoId  String             @map("documento_id") @db.Uuid
  modo         ModoEnvioDocumento
  tokenHash    String?            @unique @map("token_hash")
  /// cifrado (CLINICO): URL con el token, solo para el correo
  enlace       Bytes?
  expiraEn     DateTime?          @map("expira_en") @db.Timestamptz(6)
  enviadoPorId String             @map("enviado_por_id") @db.Uuid
  enviadoEn    DateTime           @default(now()) @map("enviado_en") @db.Timestamptz(6)

  documento  DocumentoClinico    @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  enviadoPor Usuario             @relation(fields: [enviadoPorId], references: [id], onDelete: Restrict)
  descargas  DescargaDocumento[]

  @@index([documentoId])
  @@map("envios_documento")
}

/// Cada descarga de un documento (A, append-only). La escribe
/// registrar_descarga_documento() (enlace vigente, paciente con sesion).
model DescargaDocumento {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentoId  String   @map("documento_id") @db.Uuid
  envioId      String?  @map("envio_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  descargadoEn DateTime @default(now()) @map("descargado_en") @db.Timestamptz(6)

  documento DocumentoClinico @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  envio     EnvioDocumento?  @relation(fields: [envioId], references: [id], onDelete: Restrict)
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([documentoId])
  @@map("descargas_documento")
}

// ============================================================================
// 7. Integraciones (02h, Agenda y Espacios): videollamada y feed iCal
// ============================================================================

enum ModoVideollamada {
  ENLACE_PROPIO
  JITSI

  @@map("modo_videollamada")
}

/// Sala de videollamada del profesional o practicante (A). ENLACE_PROPIO
/// (por defecto): su sala fija, cifrada. JITSI: sala unica por cita (solo si
/// la plataforma lo habilita). Edita el propio; ADMIN/GESTION leen.
model SalaVideollamada {
  usuarioId String           @id @map("usuario_id") @db.Uuid
  modo      ModoVideollamada @default(ENLACE_PROPIO)
  /// cifrado (IDENTIFICACION)
  enlace    Bytes?
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("salas_videollamada")
}

/// Feed iCal privado (A): token en la URL, guardado como SHA-256.
/// Regenerar reemplaza el hash (el anterior deja de servir).
model FeedCalendario {
  usuarioId String   @id @map("usuario_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("feeds_calendario")
}

/// Recordatorio de una cita (A, 02i). Uno por cita y horario (UNIQUE): si la
/// cita se reprograma sale otro. Token de un solo uso (SHA-256) para
/// confirmar o cancelar, valido hasta el inicio de la cita; la URL va cifrada
/// (CLINICO) solo para armar el mensaje. Lo crea el job
/// (registrar_recordatorio); la respuesta, responder_recordatorio (una vez).
model RecordatorioCita {
  id           String                 @id @db.Uuid
  citaId       String                 @map("cita_id") @db.Uuid
  inicio       DateTime               @db.Timestamptz(6)
  tokenHash    String                 @unique @map("token_hash")
  /// cifrado (CLINICO)
  enlace       Bytes
  expiraEn     DateTime               @map("expira_en") @db.Timestamptz(6)
  creadoEn     DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  respuesta    RespuestaRecordatorio?
  respondidoEn DateTime?              @map("respondido_en") @db.Timestamptz(6)
  /// Cancelacion: si fue con el aviso minimo de la politica vigente.
  aTiempo      Boolean?               @map("a_tiempo")

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Restrict)

  @@unique([citaId, inicio])
  @@map("recordatorios_cita")
}

enum RespuestaRecordatorio {
  CONFIRMADA
  CANCELADA

  @@map("respuesta_recordatorio")
}

/// Adjunto externo de la ficha (A, 02i): informe o imagen que sube el
/// tratante. Tipo validado por contenido (PDF, PNG, JPEG); archivo cifrado
/// (CLINICO, base64) con AAD; id generado por la API. Misma RLS y auditoria
/// que la ficha. Append-only.
model AdjuntoFicha {
  id            String   @id @db.Uuid
  pacienteId    String   @map("paciente_id") @db.Uuid
  subidoPorId   String   @map("subido_por_id") @db.Uuid
  nombreArchivo String   @map("nombre_archivo")
  tipoMime      String   @map("tipo_mime")
  tamanoBytes   Int      @map("tamano_bytes")
  /// cifrado (CLINICO): el archivo en base64
  contenido     Bytes
  subidoEn      DateTime @default(now()) @map("subido_en") @db.Timestamptz(6)

  paciente  Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  subidoPor Usuario  @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@map("adjuntos_ficha")
}

// ============================================================================
// 6. Alineacion con el diseño (03a-1): cuentas, portal, match, agenda.
// ============================================================================

enum ModuloCentro {
  PAGINA_PUBLICA
  FICHAS
  AGENDA
  EQUIPO
  MATCH
  COBROS

  @@map("modulo_centro")
}

/// Segundo rol de una cuenta (A, 03a C-1). Combinaciones: ADMIN+PROFESIONAL y
/// GESTION+PROFESIONAL (el principal queda en usuarios.rol). Un rol activo por
/// sesion. Baja por rol: fecha_baja programa la desactivacion (procesar_bajas).
/// Escritura solo via otorgar_rol_adicional / iniciar_baja_rol.
model RolAdicional {
  usuarioId     String    @map("usuario_id") @db.Uuid
  rol           Rol
  activo        Boolean   @default(true)
  fechaBaja     DateTime? @map("fecha_baja") @db.Timestamptz(6)
  otorgadoPorId String    @map("otorgado_por_id") @db.Uuid
  otorgadoEn    DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(6)
  desactivadoEn DateTime? @map("desactivado_en") @db.Timestamptz(6)

  usuario     Usuario @relation("RolAdicionalUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  otorgadoPor Usuario @relation("RolAdicionalOtorgadoPor", fields: [otorgadoPorId], references: [id], onDelete: Restrict)

  @@id([usuarioId, rol])
  @@map("roles_adicionales")
}

enum TipoTokenCorreo {
  VERIFICACION_SOLICITUD
  INVITACION
  RECUPERACION
  ACCESO
  VERIFICACION_CORREO
  CONSENTIMIENTO
  /// Sin uso: lista de espera publica retirada (implementacion futura).
  VERIFICACION_LISTA_ESPERA
  BAJA_LISTA_ESPERA
  /// 03b-3.4: enlace de pago de una cita (sin cuenta); varios usos hasta vencer.
  PAGO_CITA

  @@map("tipo_token_correo")
}

/// Enlaces de un solo uso enviados por correo (A, 03a): verificacion de una
/// solicitud de hora, invitacion de cuenta, recuperacion de contraseña,
/// acceso sin contraseña (paciente), cambio de correo y consentimiento. Solo
/// el SHA-256 del token. Sin GRANT: solo funciones.
model TokenCorreo {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                TipoTokenCorreo
  tokenHash           Bytes           @unique @map("token_hash")
  usuarioId           String?         @map("usuario_id") @db.Uuid
  pacienteId          String?         @map("paciente_id") @db.Uuid
  adultoResponsableId String?         @map("adulto_responsable_id") @db.Uuid
  /// Fila que autoriza (solicitud, consentimiento, aviso o politica).
  referenciaId        String?         @map("referencia_id") @db.Uuid
  /// Rol de la cuenta a crear (INVITACION) o correo nuevo (VERIFICACION_CORREO).
  rol                 Rol?
  email               String?
  expiraEn            DateTime        @map("expira_en") @db.Timestamptz(6)
  usadoEn             DateTime?       @map("usado_en") @db.Timestamptz(6)
  /// txid de la transaccion que lo consume (autoriza funciones encadenadas).
  usadoTxid           BigInt?         @map("usado_txid")
  creadoEn            DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([tipo, expiraEn])
  @@map("tokens_correo")
}

enum TipoPolitica {
  POLITICA_DATOS
  CONSENTIMIENTO_ATENCION
  TERMINOS_AGENDAMIENTO
  /// 03b-5: consentimiento de atencion con practicante supervisado (versionado).
  CONSENTIMIENTO_PRACTICANTE

  @@map("tipo_politica")
}

/// Textos legales versionados (B, 03a D-3). ADMIN publica una version nueva
/// (nunca edita ni borra); vigente = la de mayor version.
model Politica {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo         TipoPolitica
  version      Int
  texto        String
  vigenteDesde DateTime     @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  creadaPorId  String?      @map("creada_por_id") @db.Uuid

  creadaPor    Usuario?             @relation(fields: [creadaPorId], references: [id], onDelete: Restrict)
  aceptaciones AceptacionPolitica[]
  solicitudes  SolicitudHora[]      @relation("SolicitudPolitica")
  solicitudesT SolicitudHora[]      @relation("SolicitudTerminos")

  @@unique([tipo, version])
  @@map("politicas")
}

enum CanalAceptacion {
  SOLICITUD
  PORTAL
  TOKEN
  PRESENCIAL

  @@map("canal_aceptacion")
}

/// Aceptacion de una version de politica (A, append-only, 03a D-3): en la
/// solicitud de hora, en el portal, por enlace de un solo uso o registrada
/// por ADMIN/GESTION con respaldo (PRESENCIAL).
model AceptacionPolitica {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicaId          String                   @map("politica_id") @db.Uuid
  pacienteId          String?                  @map("paciente_id") @db.Uuid
  solicitudId         String?                  @map("solicitud_id") @db.Uuid
  otorgadoPor         OtorganteConsentimiento? @map("otorgado_por")
  adultoResponsableId String?                  @map("adulto_responsable_id") @db.Uuid
  canal               CanalAceptacion
  respaldoRef         String?                  @map("respaldo_ref")
  registradaPorId     String?                  @map("registrada_por_id") @db.Uuid
  aceptadaEn          DateTime                 @default(now()) @map("aceptada_en") @db.Timestamptz(6)

  politica          Politica           @relation(fields: [politicaId], references: [id], onDelete: Restrict)
  paciente          Paciente?          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  solicitud         SolicitudHora?     @relation(fields: [solicitudId], references: [id], onDelete: SetNull)
  adultoResponsable AdultoResponsable? @relation(fields: [adultoResponsableId], references: [id], onDelete: Restrict)
  registradaPor     Usuario?           @relation(fields: [registradaPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@map("aceptaciones_politica")
}

enum EstadoSolicitudHora {
  PENDIENTE_VERIFICACION
  CONCRETADA
  EXPIRADA

  @@map("estado_solicitud_hora")
}

/// Solicitud de hora sin cuenta (A, 03a D-2, C-15). Retiene el horario
/// (bloqueos_temporales) hasta verificar el correo; al verificar se crean el
/// paciente, su ficha y la cita (CONFIRMADA o SOLICITADA). Datos de contacto
/// y respuestas del match cifrados; id generado por la API. Sin GRANT: solo
/// funciones.
model SolicitudHora {
  id               String              @id @db.Uuid
  estado           EstadoSolicitudHora @default(PENDIENTE_VERIFICACION)
  profesionalId    String              @map("profesional_id") @db.Uuid
  modalidad        ModalidadAtencion
  espacioId        String?             @map("espacio_id") @db.Uuid
  inicio           DateTime            @db.Timestamptz(6)
  fin              DateTime            @db.Timestamptz(6)
  nombre           String
  apellido         String
  fechaNacimiento  DateTime            @map("fecha_nacimiento") @db.Date
  email            String
  /// cifrado (IDENTIFICACION)
  telefono         Bytes?
  /// cifrado (IDENTIFICACION); opcional en la solicitud
  rut              Bytes?
  rutHmac          Bytes?              @map("rut_hmac")
  adultoNombre     String?             @map("adulto_nombre")
  adultoParentesco String?             @map("adulto_parentesco")
  /// cifrado (IDENTIFICACION)
  adultoTelefono   Bytes?              @map("adulto_telefono")
  /// cifrado (CLINICO): respuestas del cuestionario (JSON). Se borran a los N dias si no se concreta y al alta.
  respuestas       Bytes?
  /// Profesional recomendado por el match (metricas; sin datos personales).
  recomendadoId    String?             @map("recomendado_id") @db.Uuid
  /// Versiones aceptadas al enviar la solicitud (politica de datos y terminos de agendamiento).
  politicaId       String              @map("politica_id") @db.Uuid
  terminosId       String?             @map("terminos_id") @db.Uuid
  expiraEn         DateTime            @map("expira_en") @db.Timestamptz(6)
  pacienteId       String?             @map("paciente_id") @db.Uuid
  citaId           String?             @unique @map("cita_id") @db.Uuid
  creadaEn         DateTime            @default(now()) @map("creada_en") @db.Timestamptz(6)
  concretadaEn     DateTime?           @map("concretada_en") @db.Timestamptz(6)
  /// 03b-3.1: SHA-256 del token opaco de la reserva (estado consultable sin datos personales).
  reservaHash      Bytes?              @unique @map("reserva_hash")

  profesional  Usuario              @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  espacio      Espacio?             @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  paciente     Paciente?            @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  cita         Cita?                @relation(fields: [citaId], references: [id], onDelete: Restrict)
  politica     Politica             @relation("SolicitudPolitica", fields: [politicaId], references: [id], onDelete: Restrict)
  terminos     Politica?            @relation("SolicitudTerminos", fields: [terminosId], references: [id], onDelete: Restrict)
  retencion    BloqueoTemporal?
  aceptaciones AceptacionPolitica[]

  @@index([estado, expiraEn])
  @@index([pacienteId])
  @@index([email])
  @@map("solicitudes_hora")
}

/// Imagenes publicas (C, 03a): foto de perfil y logo. Validadas por
/// contenido, redimensionadas y sin metadatos (EXIF) antes de guardarse; se
/// sirven sin autenticacion. Separadas de los adjuntos clinicos. Sin cifrar
/// por diseño (publicas). Append-only.
model ImagenPublica {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo        String
  usuarioId   String?  @map("usuario_id") @db.Uuid
  tipoMime    String   @map("tipo_mime")
  ancho       Int
  alto        Int
  tamanoBytes Int      @map("tamano_bytes")
  contenido   Bytes
  creadaEn    DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("imagenes_publicas")
}

/// Contenido de la pagina publica del centro (C, 03a). Una fila; edita ADMIN.
model ContenidoPublico {
  id               Boolean  @id @default(true)
  heroTitulo       String?  @map("hero_titulo")
  heroTexto        String?  @map("hero_texto")
  /// [{icono, titulo, texto}]
  servicios        Json     @default("[]")
  contactoCorreo   String?  @map("contacto_correo")
  contactoTelefono String?  @map("contacto_telefono")
  direccion        String?
  whatsapp         String?
  instagram        String?
  mision           String?
  vision           String?
  colorMarca       String?  @map("color_marca")
  logoImagenId     String?  @map("logo_imagen_id") @db.Uuid
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contenido_publico")
}

enum TipoPreguntaMatch {
  UNICA
  MULTIPLE
  ESCALA
  TEXTO
  DIAS
  FRANJAS

  @@map("tipo_pregunta_match")
}

/// Criterio que una opcion aplica sobre el perfil del profesional (reglas, sin IA).
enum CriterioMatch {
  TIPO_ATENCION
  ENFOQUE
  ESPECIALIDAD
  MODALIDAD
  PREVISION
  /// 03b-4.1: tope de la preferencia de pago (CLP); ordena por tramos, no puntua.
  PRESUPUESTO

  @@map("criterio_match")
}

/// Cuestionario del match (B, 03a D-5): preguntas configurables por ADMIN.
/// Nunca DELETE (se desactiva).
model MatchPregunta {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave          String            @unique
  texto          String
  ayuda          String?
  tipo           TipoPreguntaMatch
  orden          Int
  activa         Boolean           @default(true)
  obligatoria    Boolean           @default(true)
  maxSelecciones Int?              @map("max_selecciones") @db.SmallInt
  propiaCentro   Boolean           @default(false) @map("propia_centro")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  opciones MatchOpcion[]

  @@map("match_preguntas")
}

/// Opcion de una pregunta del match (B). Regla: si el paciente la elige, el
/// criterio/valor suma `peso` a los profesionales que lo cumplen; `estricto`
/// filtra (con advertencia explicable si nadie cumple). `mensaje`: texto que
/// se muestra al elegirla (p. ej. linea de ayuda en crisis).
model MatchOpcion {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  preguntaId String         @map("pregunta_id") @db.Uuid
  valor      String
  etiqueta   String
  nota       String?
  orden      Int
  activa     Boolean        @default(true)
  criterio   CriterioMatch?
  objetivo   String?
  peso       Int            @default(0) @db.SmallInt
  estricto   Boolean        @default(false)
  mensaje    String?

  pregunta MatchPregunta @relation(fields: [preguntaId], references: [id], onDelete: Restrict)

  @@unique([preguntaId, valor])
  @@map("match_opciones")
}

/// Resultado anonimo de un match completado (C, 03a C-17): solo fecha y
/// profesional recomendado, para las metricas. Sin respuestas ni contacto.
model MatchResultado {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId String?  @map("profesional_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([creadoEn])
  @@map("match_resultados")
}

enum EstadoResena {
  PENDIENTE
  PUBLICADA
  OCULTA
  RETIRADA

  @@map("estado_resena")
}

enum MostrarResena {
  ANONIMO
  NOMBRE_INICIAL

  @@map("mostrar_resena")
}

/// Reseña de un paciente a un profesional (A, 03a D-1). Una por paciente y
/// profesional, con al menos una sesion realizada. ADMIN modera antes de
/// publicar; el autor edita (vuelve a moderacion) o retira. Texto y feedback
/// privado cifrados (CLINICO). Se eliminan con la baja del profesional.
model Resena {
  id                 String        @id @db.Uuid
  pacienteId         String        @map("paciente_id") @db.Uuid
  profesionalId      String        @map("profesional_id") @db.Uuid
  autorId            String        @map("autor_id") @db.Uuid
  calificacion       Int           @db.SmallInt
  /// cifrado (CLINICO)
  texto              Bytes?
  /// cifrado (CLINICO): solo lo lee el profesional
  feedbackPrivado    Bytes?        @map("feedback_privado")
  mostrarComo        MostrarResena @default(ANONIMO) @map("mostrar_como")
  estado             EstadoResena  @default(PENDIENTE)
  motivoOcultamiento String?       @map("motivo_ocultamiento")
  moderadaPorId      String?       @map("moderada_por_id") @db.Uuid
  moderadaEn         DateTime?     @map("moderada_en") @db.Timestamptz(6)
  creadaEn           DateTime      @default(now()) @map("creada_en") @db.Timestamptz(6)
  editadaEn          DateTime?     @map("editada_en") @db.Timestamptz(6)

  paciente    Paciente        @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profesional Usuario         @relation("ResenaProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  autor       Usuario         @relation("ResenaAutor", fields: [autorId], references: [id], onDelete: Restrict)
  moderadaPor Usuario?        @relation("ResenaModeradaPor", fields: [moderadaPorId], references: [id], onDelete: Restrict)
  reportes    ResenaReporte[]

  @@unique([pacienteId, profesionalId])
  @@index([profesionalId, estado])
  @@map("resenas")
}

/// Reporte publico de una reseña (A). Lo revisa ADMIN.
model ResenaReporte {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resenaId String   @map("resena_id") @db.Uuid
  motivo   String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  resena Resena @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@index([resenaId])
  @@map("resenas_reportes")
}

/// Auditoria de reseñas (A, append-only): creacion, edicion, moderacion,
/// retiro, reporte y eliminacion por baja. Sobrevive a la reseña.
model ResenaEvento {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resenaId String   @map("resena_id") @db.Uuid
  accion   String
  actorId  String?  @map("actor_id") @db.Uuid
  rol      String?
  motivo   String?
  en       DateTime @default(now()) @db.Timestamptz(6)

  @@index([resenaId])
  @@map("resenas_eventos")
}

/// Alta del paciente (A, append-only, 03a): la registra el tratante con fecha
/// y motivo (cifrado, CLINICO). La ficha se conserva; borra las respuestas del match.
model AltaPaciente {
  id              String   @id @db.Uuid
  pacienteId      String   @map("paciente_id") @db.Uuid
  fecha           DateTime @db.Date
  /// cifrado (CLINICO)
  motivo          Bytes
  registradaPorId String   @map("registrada_por_id") @db.Uuid
  creadaEn        DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  registradaPor Usuario  @relation(fields: [registradaPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@map("altas_paciente")
}

/// Horario general del centro (B, 03a): minutos locales 0-1440 por dia ISO.
/// Sin filas = sin restriccion. Las citas caen dentro (trigger).
model HorarioCentro {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  diaSemana Int    @map("dia_semana") @db.SmallInt
  inicioMin Int    @map("inicio_min") @db.SmallInt
  finMin    Int    @map("fin_min") @db.SmallInt

  @@map("horario_centro")
}

/// Horario de un box (B, 03a). Sin filas = el del centro. Las citas
/// presenciales en ese box caen dentro (trigger).
model HorarioEspacio {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  espacioId    String    @map("espacio_id") @db.Uuid
  diaSemana    Int       @map("dia_semana") @db.SmallInt
  inicioMin    Int       @map("inicio_min") @db.SmallInt
  finMin       Int       @map("fin_min") @db.SmallInt
  /// 03b: periodo en que rige la fila (semana, mes, trimestre); nulo = sin limite.
  vigenteDesde DateTime? @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Restrict)

  @@index([espacioId])
  @@map("horarios_espacio")
}

enum MotivoAccesoTemporal {
  REEMPLAZO
  INTERCONSULTA

  @@map("motivo_acceso_temporal")
}

enum AlcanceAccesoTemporal {
  LECTURA
  LECTURA_ESCRITURA

  @@map("alcance_acceso_temporal")
}

/// Acceso clinico temporal a la ficha de un paciente (A, append-only, 03a
/// C-4/C-5): reemplazo o interconsulta, con alcance y fecha de termino; se
/// corta solo al vencer. Lo otorgan ADMIN o el tratante; avisa al paciente y
/// se audita en accesos_ficha.
model AccesoClinicoTemporal {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId    String                @map("paciente_id") @db.Uuid
  profesionalId String                @map("profesional_id") @db.Uuid
  motivo        MotivoAccesoTemporal
  alcance       AlcanceAccesoTemporal
  desde         DateTime              @default(now()) @db.Timestamptz(6)
  hasta         DateTime              @db.Timestamptz(6)
  otorgadoPorId String                @map("otorgado_por_id") @db.Uuid
  creadoEn      DateTime              @default(now()) @map("creado_en") @db.Timestamptz(6)

  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profesional Usuario  @relation("AccesoTemporalProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  otorgadoPor Usuario  @relation("AccesoTemporalOtorgadoPor", fields: [otorgadoPorId], references: [id], onDelete: Restrict)

  @@index([profesionalId, hasta])
  @@index([pacienteId])
  @@map("accesos_clinicos_temporales")
}

/// Borrador de evolucion (A, 03a C-8): fuera de la ficha, solo su autor lo
/// ve, editable (guardado automatico) y descartable. Al confirmarlo pasa a
/// evolucion y se elimina. Contenido cifrado (CLINICO); id generado por la API.
model BorradorEvolucion {
  id             String   @id @db.Uuid
  autorId        String   @map("autor_id") @db.Uuid
  fichaClinicaId String   @map("ficha_clinica_id") @db.Uuid
  citaId         String?  @map("cita_id") @db.Uuid
  /// cifrado (CLINICO)
  contenido      Bytes
  /// 03a-2: plantilla de evolucion
  plantillaId    String?  @map("plantilla_id") @db.Uuid
  /// cifrado (CLINICO): valores de la plantilla
  valores        Bytes?
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  autor        Usuario           @relation(fields: [autorId], references: [id], onDelete: Restrict)
  fichaClinica FichaClinica      @relation(fields: [fichaClinicaId], references: [id], onDelete: Restrict)
  cita         Cita?             @relation(fields: [citaId], references: [id], onDelete: Restrict)
  plantilla    PlantillaClinica? @relation(fields: [plantillaId], references: [id], onDelete: Restrict)

  @@index([autorId])
  @@map("borradores_evolucion")
}

// ============================================================================
// 03a-2. Campos clinicos por especialidad y mensajeria interna del equipo
// ============================================================================

enum TipoPlantillaClinica {
  /// Ficha de ingreso / anamnesis.
  INGRESO
  EVOLUCION

  @@map("tipo_plantilla_clinica")
}

enum EstadoPlantillaClinica {
  BORRADOR
  PUBLICADA
  INACTIVA

  @@map("estado_plantilla_clinica")
}

enum TipoHiloInterno {
  /// Coordinacion sin paciente (no se nombra a pacientes).
  GENERAL
  /// Vinculado a un paciente: solo quien tiene acceso clinico vigente.
  CASO

  @@map("tipo_hilo_interno")
}

/// Catalogo (B): solo ADMIN escribe, sin DELETE (se desactiva).
model Especialidad {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profesionales ProfesionalEspecialidad[]
  plantillas    PlantillaClinica[]

  @@map("especialidades")
}

/// Especialidades del profesional (B): el profesional declara (PROPUESTO),
/// ADMIN aprueba o rechaza, igual que profesional_tipos_atencion.
model ProfesionalEspecialidad {
  profesionalId  String           @map("profesional_id") @db.Uuid
  especialidadId String           @map("especialidad_id") @db.Uuid
  estado         EstadoTipoSesion @default(PROPUESTO)
  revisadoPorId  String?          @map("revisado_por_id") @db.Uuid
  revisadoEn     DateTime?        @map("revisado_en") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  profesional  Usuario      @relation("EspecialidadProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  especialidad Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Restrict)
  revisadoPor  Usuario?     @relation("EspecialidadRevisadaPor", fields: [revisadoPorId], references: [id], onDelete: Restrict)

  @@id([profesionalId, especialidadId])
  @@index([especialidadId])
  @@map("profesional_especialidades")
}

/// Plantilla clinica (B), una fila por version; familia_id = id de la
/// version 1. Una version PUBLICADA es inmutable (solo pasa a INACTIVA);
/// editar crea una version nueva. Nunca se borra. Escritura solo via
/// funciones (proponer, editar borrador, nueva version, publicar, desactivar).
model PlantillaClinica {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familiaId      String                 @map("familia_id") @db.Uuid
  especialidadId String                 @map("especialidad_id") @db.Uuid
  tipo           TipoPlantillaClinica
  nombre         String
  version        Int
  estado         EstadoPlantillaClinica @default(BORRADOR)
  /// Campos: clave, etiqueta, tipo, obligatorio, opciones, orden, visible_en_supervision, es_texto_libre.
  definicion     Json
  /// Nulo = ejemplo cargado por la migracion.
  propuestaPorId String?                @map("propuesta_por_id") @db.Uuid
  publicadaPorId String?                @map("publicada_por_id") @db.Uuid
  publicadaEn    DateTime?              @map("publicada_en") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  especialidad Especialidad        @relation(fields: [especialidadId], references: [id], onDelete: Restrict)
  propuestaPor Usuario?            @relation("PlantillaPropuestaPor", fields: [propuestaPorId], references: [id], onDelete: Restrict)
  publicadaPor Usuario?            @relation("PlantillaPublicadaPor", fields: [publicadaPorId], references: [id], onDelete: Restrict)
  evoluciones  Evolucion[]
  borradores   BorradorEvolucion[]
  ingresos     IngresoFicha[]

  @@unique([familiaId, version])
  @@index([especialidadId, tipo])
  @@map("plantillas_clinicas")
}

/// Ficha de ingreso / anamnesis (A, append-only como evoluciones): valores
/// de una version de plantilla INGRESO, cifrados como un solo JSON. Una
/// correccion es fila nueva con corrige_a_id y la misma version.
model IngresoFicha {
  id             String   @id @db.Uuid
  fichaClinicaId String   @map("ficha_clinica_id") @db.Uuid
  autorId        String   @map("autor_id") @db.Uuid
  plantillaId    String   @map("plantilla_id") @db.Uuid
  /// cifrado (CLINICO)
  valores        Bytes
  corrigeAId     String?  @unique @map("corrige_a_id") @db.Uuid
  createdAt      DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  fichaClinica FichaClinica     @relation(fields: [fichaClinicaId], references: [id], onDelete: Restrict)
  autor        Usuario          @relation(fields: [autorId], references: [id], onDelete: Restrict)
  plantilla    PlantillaClinica @relation(fields: [plantillaId], references: [id], onDelete: Restrict)
  corrigeA     IngresoFicha?    @relation("CorreccionIngreso", fields: [corrigeAId], references: [id], onDelete: Restrict)
  corregidoPor IngresoFicha?    @relation("CorreccionIngreso")

  @@index([fichaClinicaId, createdAt])
  @@map("ingresos_ficha")
}

/// Hilo de mensajeria interna (A). La mensajeria no es el expediente: toda
/// decision clinica se registra en una evolucion. Asunto cifrado (CLINICO).
model HiloInterno {
  id              String          @id @db.Uuid
  tipo            TipoHiloInterno
  /// cifrado (CLINICO)
  asunto          Bytes
  pacienteId      String?         @map("paciente_id") @db.Uuid
  creadoPorId     String          @map("creado_por_id") @db.Uuid
  creadoEn        DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  ultimoMensajeEn DateTime        @default(now()) @map("ultimo_mensaje_en") @db.Timestamptz(6)

  paciente      Paciente?          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  creadoPor     Usuario            @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  participantes ParticipanteHilo[]
  mensajes      MensajeInterno[]
  lecturas      LecturaHilo[]

  @@index([pacienteId])
  @@index([ultimoMensajeEn])
  @@map("hilos_internos")
}

/// Participantes de un hilo GENERAL (A). Los de un hilo CASO no se guardan:
/// son quienes tienen acceso clinico vigente al paciente en cada lectura.
model ParticipanteHilo {
  hiloId     String   @map("hilo_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  agregadoEn DateTime @default(now()) @map("agregado_en") @db.Timestamptz(6)

  hilo    HiloInterno @relation(fields: [hiloId], references: [id], onDelete: Restrict)
  usuario Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([hiloId, usuarioId])
  @@index([usuarioId])
  @@map("participantes_hilo")
}

/// Mensaje interno (A). Sin edicion; el autor lo retira dentro de 5 minutos
/// (contenido nulo: "mensaje retirado"). Lo purga el job de retencion.
model MensajeInterno {
  id         String    @id @db.Uuid
  hiloId     String    @map("hilo_id") @db.Uuid
  autorId    String    @map("autor_id") @db.Uuid
  /// Rol activo con que se envio.
  rolAutor   Rol       @map("rol_autor")
  /// cifrado (CLINICO); nulo si fue retirado
  contenido  Bytes?
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  retiradoEn DateTime? @map("retirado_en") @db.Timestamptz(6)

  hilo  HiloInterno @relation(fields: [hiloId], references: [id], onDelete: Restrict)
  autor Usuario     @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([hiloId, creadoEn])
  @@index([creadoEn])
  @@map("mensajes_internos")
}

/// Ultima lectura de cada participante en un hilo (A).
model LecturaHilo {
  hiloId    String   @map("hilo_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  leidoEn   DateTime @default(now()) @map("leido_en") @db.Timestamptz(6)

  hilo    HiloInterno @relation(fields: [hiloId], references: [id], onDelete: Restrict)
  usuario Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([hiloId, usuarioId])
  @@map("lecturas_hilo")
}

/// Correo de cuenta que fallo al enviarse (A): se reintenta con backoff y se
/// borra al enviarse o al vencer su enlace. Destinatario y cuerpo (con el
/// enlace de un solo uso) cifrados. Solo el job lo lee.
model CorreoCuentaPendiente {
  id             String   @id @db.Uuid
  /// cifrado (IDENTIFICACION)
  email          Bytes
  asunto         String
  /// cifrado (IDENTIFICACION)
  cuerpo         Bytes
  intentos       Int      @default(1)
  proximoIntento DateTime @map("proximo_intento") @db.Timestamptz(6)
  venceEn        DateTime @map("vence_en") @db.Timestamptz(6)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([proximoIntento])
  @@map("correos_cuenta_pendientes")
}

/// 03b (A+C): horas de box apartadas por un profesional o practicante dentro
/// del horario del box; son su agenda (una cita solo cae dentro de un bloque
/// suyo y la presencial usa el box del bloque). EXCLUDE por box y por
/// profesional. Liberar con citas o retenciones dentro = 55000. Otros roles
/// ven la ocupacion via ocupacion_espacios() / disponibilidad_espacios().
model BloqueAtencion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profesionalId String   @map("profesional_id") @db.Uuid
  espacioId     String   @map("espacio_id") @db.Uuid
  inicio        DateTime @db.Timestamptz(6)
  fin           DateTime @db.Timestamptz(6)
  creadoPorId   String?  @map("creado_por_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  profesional Usuario  @relation("BloqueAtencionProfesional", fields: [profesionalId], references: [id], onDelete: Restrict)
  espacio     Espacio  @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  creadoPor   Usuario? @relation("BloqueAtencionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([profesionalId, inicio])
  @@index([espacioId, inicio])
  @@map("bloques_atencion")
}

/// 03b-4.1: codigo de verificacion en dos pasos enviado por correo (A). Solo
/// HMAC del codigo; vence en 10 minutos, un uso, 5 intentos. Sin GRANT: solo
/// funciones.
model CodigoVerificacion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  codigoHash Bytes     @map("codigo_hash")
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(6)
  intentos   Int       @default(0) @db.SmallInt
  usadoEn    DateTime? @map("usado_en") @db.Timestamptz(6)
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, creadoEn])
  @@map("codigos_verificacion")
}

/// 03b-4.1: codigos de respaldo del segundo factor (A), 10 por activacion, un
/// uso. Solo HMAC. Sin GRANT: solo funciones.
model CodigoRespaldo {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  codigoHash Bytes     @map("codigo_hash")
  usadoEn    DateTime? @map("usado_en") @db.Timestamptz(6)
  anuladoEn  DateTime? @map("anulado_en") @db.Timestamptz(6)
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("codigos_respaldo")
}
