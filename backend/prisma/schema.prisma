  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  evoluciones EvolucionIntervencion[]

  @@map("intervenciones")
}

/// Catalogo (B) cualitativo, sin escala numerica: ADMIN escribe, sin DELETE.
model EstadoAvance {
