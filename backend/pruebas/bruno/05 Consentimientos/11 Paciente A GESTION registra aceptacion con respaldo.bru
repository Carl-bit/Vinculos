meta {
  name: Paciente A: GESTION registra aceptacion con respaldo
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/consentimientos/{{consentAId}}/respuesta
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "acepta": true,
    "otorgadoPorTipo": "PACIENTE",
    "respaldoDocumentoRef": "scan-consentimiento-A.pdf",
    "versionDocumento": "v1"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado", function () {
    expect(res.body.estado).to.equal("ACEPTADO");
  });
}
