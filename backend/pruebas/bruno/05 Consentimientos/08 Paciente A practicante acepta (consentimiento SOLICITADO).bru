meta {
  name: Paciente A: practicante acepta (consentimiento SOLICITADO)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/derivaciones/{{derivAId}}/respuesta
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPracticante}}
}

body:json {
  {
    "acepta": true
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
