meta {
  name: Paciente A: derivar sin candidatos
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/derivaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

body:json {
  {
    "fichaId": "{{fichaAId}}",
    "motivo": "Derivacion a practicante (prueba manual)",
    "tipoAtencionId": "{{tipoAtencionId}}",
    "candidatos": []
  }
}

script:post-response {
  bru.setVar("derivAId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
