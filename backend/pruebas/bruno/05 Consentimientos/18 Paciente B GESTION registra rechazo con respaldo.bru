meta {
  name: Paciente B: GESTION registra rechazo con respaldo
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/consentimientos/{{consentBId}}/respuesta
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "acepta": false,
    "otorgadoPorTipo": "PACIENTE",
    "respaldoDocumentoRef": "scan-consentimiento-B.pdf"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("estado", function () {
    expect(res.body.estado).to.equal("RECHAZADO");
  });
}
