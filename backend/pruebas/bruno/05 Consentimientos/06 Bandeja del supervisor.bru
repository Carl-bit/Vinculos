}

get {
  url: {{baseUrl}}/derivaciones/pendientes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenProf2}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("incluye la derivacion", function () {
    expect(res.body.map((d) => d.derivacionId)).to.include(bru.getVar("derivAId"));
  });
}
