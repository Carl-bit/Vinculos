meta {
  name: Supervisor: casos seudonimizados
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/supervision/casos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenProf2}}
}

script:post-response {
  bru.setVar("codigoCaso", res.body[0].codigo);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("sin identificadores", function () {
    const s = JSON.stringify(res.body);
    expect(s).to.not.include("Camila");
    expect(s).to.not.include(bru.getVar("camilaId"));
    expect(res.body[0].codigo).to.match(/^C-/);
  });
}
