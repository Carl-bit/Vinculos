meta {
  name: Tipos de atencion
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/tipos-atencion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

script:post-response {
  bru.setVar("tipoAtencionId", res.body.find((t) => t.nombre === "Psicoterapia individual adultos").id);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
