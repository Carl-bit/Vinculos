meta {
  name: Paciente A: crear
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/pacientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

body:json {
  {
    "nombre": "Consentimiento Acepta",
    "apellido": "Demo",
    "fechaNacimiento": "1990-01-01"
  }
}

script:post-response {
  bru.setVar("pacAId", res.body.id);
  bru.setVar("fichaAId", res.body.fichaId);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
