meta {
  name: Paciente B: crear
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/pacientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

body:json {
  {
    "nombre": "Consentimiento Rechaza",
    "apellido": "Demo",
    "fechaNacimiento": "1990-01-01"
  }
}

script:post-response {
  bru.setVar("pacBId", res.body.id);
  bru.setVar("fichaBId", res.body.fichaId);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
