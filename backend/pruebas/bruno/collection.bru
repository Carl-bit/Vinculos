script:pre-request {
  // Horarios de las citas de prueba: N dias habiles desde hoy a las 15:00Z
  // (12:00 en Chile con horario de verano, 11:00 sin el): siempre dentro de la
  // disponibilidad demo (lunes a viernes 09:00-19:00) y sin chocar con las
  // citas del seed demo (dias habiles 4 a 7).
  function habil(n, horaUtc) {
    const d = new Date();
    d.setUTCHours(horaUtc, 0, 0, 0);
    let k = 0;
    while (k < n) {
      d.setUTCDate(d.getUTCDate() + 1);
      const w = d.getUTCDay();
      if (w !== 0 && w !== 6) k++;
    }
    return d;
  }
  const min = 60000;
  const iso = (d) => d.toISOString();
  const c = habil(10, 15);
  bru.setVar("citaInicio", iso(c));
  bru.setVar("citaFin", iso(new Date(c.getTime() + 50 * min)));
  bru.setVar("margenInicio", iso(new Date(c.getTime() + 60 * min)));
  bru.setVar("margenFin", iso(new Date(c.getTime() + 110 * min)));
  bru.setVar("reprogInicio", iso(new Date(c.getTime() + 120 * min)));
  bru.setVar("reprogFin", iso(new Date(c.getTime() + 170 * min)));
  const t = habil(12, 15);
  bru.setVar("aTiempoInicio", iso(t));
  bru.setVar("aTiempoFin", iso(new Date(t.getTime() + 50 * min)));
  const tarde = habil(3, 16);
  bru.setVar("tardiaInicio", iso(tarde));
  bru.setVar("tardiaFin", iso(new Date(tarde.getTime() + 50 * min)));
  bru.setVar("desde", iso(new Date()));
  bru.setVar("hasta", iso(new Date(Date.now() + 14 * 86400000)));
}

docs {
  Coleccion de pruebas manuales de la API (02j). Antes de una corrida completa:
  `npm run demo:reset` (los flujos cambian estado: derivacion aceptada, pagos).
  Guion y resultados esperados: docs/pruebas/guion_manual.md.
}
