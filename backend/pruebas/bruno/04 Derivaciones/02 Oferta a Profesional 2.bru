meta {
  name: Oferta a Profesional 2
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/derivaciones/{{derivacionId}}/oferta
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenProf2}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("sin lista de candidatos ni paciente", function () {
    const s = JSON.stringify(res.body);
    expect(s).to.not.include("candidatos");
    expect(s).to.not.include(bru.getVar("diegoId"));
  });
}
