meta {
  name: Corregir evolucion (fila nueva)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/fichas/{{fichaPruebaId}}/evoluciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

body:json {
  {
    "notas": "Correccion de la evolucion anterior.",
    "tipoSesionId": "{{tipoSesionId}}",
    "nivelRiesgo": "BAJO",
    "corrigeAId": "{{evolucionId}}"
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
