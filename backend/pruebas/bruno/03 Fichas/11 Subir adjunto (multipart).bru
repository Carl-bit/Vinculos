meta {
  name: Subir adjunto (multipart)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/pacientes/{{pacientePruebaId}}/adjuntos
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

body:multipart-form {
  archivo: @file(fixtures/informe-demo.pdf)
}

script:post-response {
  bru.setVar("adjuntoId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
