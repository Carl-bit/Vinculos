meta {
  name: Ficha de Paciente Prueba
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/pacientes/{{pacientePruebaId}}/ficha
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenProf1}}
}

script:post-response {
  bru.setVar("fichaPruebaId", res.body.id);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
