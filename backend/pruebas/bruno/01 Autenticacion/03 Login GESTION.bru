meta {
  name: Login GESTION
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "gestion@centro-prueba.cl",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("tokenGestion", res.body.accessToken);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("entrega access y refresh", function () {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}
