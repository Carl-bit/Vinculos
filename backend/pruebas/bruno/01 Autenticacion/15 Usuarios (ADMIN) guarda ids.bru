meta {
  name: Usuarios (ADMIN) guarda ids
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  const id = (email) => res.body.find((u) => u.email === email).id;
  bru.setVar("idProf1", id("profesional1@centro-prueba.cl"));
  bru.setVar("idProf2", id("profesional2@centro-prueba.cl"));
  bru.setVar("idProf3", id("profesional3@centro-prueba.cl"));
  bru.setVar("idPracticante", id("practicante@centro-prueba.cl"));
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("un usuario por rol", function () {
    const roles = res.body.map((u) => u.rol);
    ["ADMIN", "GESTION", "PROFESIONAL", "PRACTICANTE", "PACIENTE"].forEach((r) => expect(roles).to.include(r));
  });
}
