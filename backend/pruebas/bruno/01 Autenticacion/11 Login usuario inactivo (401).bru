meta {
  name: Login usuario inactivo (401)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "inactivo@centro-prueba.cl",
    "password": "{{password}}"
  }
}

tests {
  test("status 401", function () {
    expect(res.status).to.equal(401);
  });
  test("mensaje generico (no revela el motivo)", function () {
    expect(res.body.mensaje).to.equal("Credenciales invalidas o cuenta sin acceso");
  });
}
