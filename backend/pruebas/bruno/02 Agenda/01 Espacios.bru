meta {
  name: Espacios
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/espacios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

script:post-response {
  bru.setVar("boxId", res.body.find((e) => e.nombre === "Box 1 (Demo)").id);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
