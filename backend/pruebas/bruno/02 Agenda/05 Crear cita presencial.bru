meta {
  name: Crear cita presencial
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/citas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "pacienteId": "{{pacientePruebaId}}",
    "profesionalId": "{{idProf1}}",
    "modalidad": "PRESENCIAL",
    "espacioId": "{{boxId}}",
    "inicio": "{{citaInicio}}",
    "fin": "{{citaFin}}"
  }
}

script:post-response {
  bru.setVar("citaId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
  test("monto fijado por la tarifa", function () {
    expect(res.body.monto).to.equal(35000);
  });
}
