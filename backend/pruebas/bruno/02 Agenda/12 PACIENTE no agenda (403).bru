meta {
  name: PACIENTE no agenda (403)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/citas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPaciente}}
}

body:json {
  {
    "pacienteId": "{{pacientePruebaId}}",
    "profesionalId": "{{idProf1}}",
    "modalidad": "ONLINE",
    "inicio": "{{citaInicio}}",
    "fin": "{{citaFin}}"
  }
}

tests {
  test("status 403", function () {
    expect(res.status).to.equal(403);
  });
}
