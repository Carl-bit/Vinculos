}

auth:bearer {
  token: {{tokenProf2}}
}

body:json {
  {
    "nombre": "Tomas",
    "apellido": "Demo Menor Sin Adulto",
    "fechaNacimiento": "2016-01-01"
  }
}

script:post-response {
  bru.setVar("menorSinAdultoId", res.body.id);
}

tests {
