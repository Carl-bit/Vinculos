meta {
  name: Reprogramar cita
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/citas/{{citaId}}/reprogramacion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "inicio": "{{reprogInicio}}",
    "fin": "{{reprogFin}}"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("conserva el monto", function () {
    expect(res.body.monto).to.equal(35000);
  });
}
