meta {
  name: Cita de menor sin adulto responsable (422)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/citas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenProf2}}
}

body:json {
  {
    "pacienteId": "{{menorSinAdultoId}}",
    "profesionalId": "{{idProf2}}",
    "modalidad": "ONLINE",
    "inicio": "{{citaInicio}}",
    "fin": "{{citaFin}}"
  }
}

tests {
  test("status 422", function () {
    expect(res.status).to.equal(422);
  });
}
