meta {
  name: Tardia: devolucion con penalizacion
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/cobros/citas/{{citaTardiaId}}/resolucion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "decision": "DEVOLUCION"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("tardia", function () {
    expect(res.body.resolucion.aTiempo).to.equal(false);
    expect(Number(res.body.resolucion.porcentaje)).to.equal(50);
  });
}
