meta {
  name: Estados de pago
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cobros/citas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

script:post-response {
  const c = res.body.find((x) => x.estado_pago === "PARCIAL");
  bru.setVar("citaParcialId", c.cita_id);
  bru.setVar("saldoParcial", c.saldo);
  bru.setVar("sobrepago", c.saldo + 1);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
