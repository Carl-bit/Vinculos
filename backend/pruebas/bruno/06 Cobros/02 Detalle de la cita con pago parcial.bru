meta {
  name: Detalle de la cita con pago parcial
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cobros/citas/{{citaParcialId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("monto fijo y PARCIAL", function () {
    expect(res.body.monto).to.equal(35000);
    expect(res.body.estado_pago).to.equal("PARCIAL");
  });
}
