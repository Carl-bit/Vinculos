meta {
  name: A tiempo: devolucion completa
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/cobros/citas/{{citaATiempoId}}/resolucion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "decision": "DEVOLUCION"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("a tiempo, devuelve todo", function () {
    expect(res.body.resolucion.aTiempo).to.equal(true);
    expect(res.body.resolucion.montoDevolucion).to.equal(10000);
  });
}
