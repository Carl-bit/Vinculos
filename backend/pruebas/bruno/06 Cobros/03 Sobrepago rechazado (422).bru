meta {
  name: Sobrepago rechazado (422)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/cobros/citas/{{citaParcialId}}/pagos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGestion}}
}

body:json {
  {
    "monto": {{sobrepago}},
    "medioPago": "TRANSFERENCIA"
  }
}

tests {
  test("status 422", function () {
    expect(res.status).to.equal(422);
  });
  test("regla", function () {
    expect(res.body.restriccion).to.equal("pagos_sin_sobrepago");
  });
}
