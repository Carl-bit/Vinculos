meta {
  name: Perfiles publicos (sin sesion)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/publico/profesionales
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("sin datos de contacto", function () {
    expect(res.body.length).to.be.greaterThan(2);
    expect(JSON.stringify(res.body)).to.not.include("@centro-prueba.cl");
  });
}
