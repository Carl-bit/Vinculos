meta {
  name: Avisos legales no se desactivan (400)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/notificaciones/preferencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPaciente}}
}

body:json {
  {
    "avisosLegales": false
  }
}

tests {
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });
}
