meta {
  name: Desactivar recordatorios
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/notificaciones/preferencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPaciente}}
}

body:json {
  {
    "recordatorios": false
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("guardado", function () {
    expect(res.body.recordatorios).to.equal(false);
  });
}
