meta {
  name: ADMIN no tiene preferencias (403)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/notificaciones/preferencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "recordatorios": false
  }
}

tests {
  test("status 403", function () {
    expect(res.status).to.equal(403);
  });
}
