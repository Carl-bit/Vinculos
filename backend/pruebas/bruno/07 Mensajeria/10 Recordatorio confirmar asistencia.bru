meta {
  name: Recordatorio: confirmar asistencia
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/recordatorios/{{tokenRecordatorio}}/confirmacion
  body: none
  auth: none
}

tests {
  const token = bru.getEnvVar("tokenRecordatorio");
  if (!token) {
    test("sin token: pegar en el entorno el del correo de recordatorio (Mailpit)", function () {});
  } else {
    test("confirmada", function () {
      expect(res.status).to.equal(200);
      expect(res.body.respuesta).to.equal("CONFIRMADA");
    });
  }
}
