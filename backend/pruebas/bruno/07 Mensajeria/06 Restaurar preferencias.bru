meta {
  name: Restaurar preferencias
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/notificaciones/preferencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenPaciente}}
}

body:json {
  {
    "recordatorios": true,
    "avisosOperativos": true
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
