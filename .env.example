# Plano del host (docker-compose.yml de la raiz). Copiar a .env y completar.
# Los .env de cada silo los genera infra/servidor/servidor.sh en
# infra/servidor/silos/<slug>.env (fuera de git).

# Let's Encrypt por DNS en Cloudflare (sin puertos abiertos).
ACME_EMAIL=operador@midominio.cl
# Token de API de Cloudflare: Zone > DNS > Edit y Zone > Zone > Read, solo de esta zona.
CF_DNS_API_TOKEN=

# Bandeja de correo de los silos de prueba.
DOMINIO_CORREO=correo.midominio.cl
# usuario:contraseña (sin espacios). Quien la tenga lee los codigos de ingreso.
MAILPIT_UI_AUTH=vinculos:cambiar
